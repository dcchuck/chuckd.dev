---
import { themes } from '../themes';
---
<details class="site-menu">
  <summary class="font-title cursor-pointer">menu</summary>
  <div class="menu-options">
    <button type="button" data-toggle-mode aria-label="Toggle black / white">Toggle black / white</button>
    <span class="menu-label">Theme</span>
    {themes.map(theme => <button type="button" data-set-theme={theme.id} aria-label={theme.label} aria-pressed="false">{theme.label}</button>)}
  </div>
</details>
