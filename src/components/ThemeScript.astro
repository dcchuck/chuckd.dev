---
import { themes } from '../themes';
---
<script is:inline define:vars={{ themes }}>
(() => {
  const valid = id => themes.some(theme => theme.id === id);
  window.setTheme = id => {
    if (!valid(id)) return false;
    document.documentElement.dataset.theme = id;
    const url = new URL(location.href);
    if (url.searchParams.has('theme') && url.searchParams.get('theme') !== id) {
      url.searchParams.set('theme', id);
      history.replaceState(null, '', url);
    }
    try { localStorage.setItem('theme', id); } catch {}
    document.querySelectorAll('[data-theme-picker]').forEach(picker => picker.value = id);
    window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: id } }));
    return true;
  };
  window.setColorMode = mode => {
    if (mode !== 'light' && mode !== 'dark') return;
    document.documentElement.dataset.mode = mode;
    try { localStorage.setItem('color-mode', mode); } catch {}
    window.dispatchEvent(new CustomEvent('modechange', { detail: { mode } }));
  };
  let saved, mode;
  try { saved = localStorage.getItem('theme'); mode = localStorage.getItem('color-mode'); } catch {}
  window.setColorMode(mode === 'light' || mode === 'dark' ? mode : saved === 'light' ? 'light' : 'dark');
  const requested = new URLSearchParams(location.search).get('theme');
  window.setTheme(valid(requested) ? requested : valid(saved) ? saved : saved === 'light' || saved === 'dark' ? 'goonies' : 'default');
})();
</script>
