---
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import Biography from './Biography.astro';
import { themes } from '../themes';
import '../styles/skins.css';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.date.getTime()-a.data.date.getTime());
---
<div id="skin-experience">
  <div class="desktop" aria-label="Desktop">
    <button data-open="about"><span class="desktop-icon document-icon">W</span>About Me.doc</button>
    <button data-open="blog"><span class="desktop-icon folder-icon"></span>Blog</button>
    <button data-open="projects"><span class="desktop-icon folder-icon"></span>Projects</button>
    <button data-open="cmd"><span class="desktop-icon prompt-icon">&gt;_</span>Command Prompt</button>
    <a href="https://github.com/dcchuck"><span class="desktop-icon globe-icon">◎</span>GitHub</a>
    <a href="https://x.com/dcChuck"><span class="desktop-icon globe-icon">◎</span>X</a>
  </div>
  <section class="classic-window" id="document-window" aria-label="WordPad">
    <div class="titlebar"><strong id="document-title">About Me.doc - WordPad</strong><div><button data-window="minimize" aria-label="Minimize">_</button><button data-window="maximize" aria-label="Maximize">□</button><button data-window="close" aria-label="Close">×</button></div></div>
    <nav class="wordpad-menu" aria-label="WordPad navigation"><button data-open="about">File</button><button data-open="blog">Blog</button><button data-open="projects">Projects</button><button data-open="cmd">Command Prompt</button><button data-help>Help</button></nav>
    <div class="wordpad-toolbar"><button data-open="about" title="Open biography">📄</button><button data-open="projects" title="Open projects">📁</button><button data-print title="Print document">▤</button><span class="toolbar-divider"></span><span class="font-box">Times New Roman</span><span class="font-box">12</span><span class="font-box">Western</span></div>
    <div class="ruler" aria-hidden="true"></div>
    <main id="document-content" tabindex="-1"></main>
    <div class="statusbar"><span>For Help, choose Help</span><span>NUM</span></div>
  </section>
  <section id="terminal-window" aria-label="Terminal">
    <div class="titlebar cmd-title"><strong>Command Prompt</strong><button data-close-cmd aria-label="Close Command Prompt">×</button></div>
    <div class="terminal-body">
      <div id="terminal-output" role="log" aria-label="Command output" aria-live="polite"></div>
      <form id="command-form" autocomplete="off"><label for="command-input" id="command-prompt">chuck@chuckd ~ %</label><input id="command-input" aria-label="Command" spellcheck="false" autocapitalize="off" /></form>
    </div>
  </section>
  <div class="start-menu" hidden><strong>chuckd.dev</strong><button data-open="about">About Me.doc</button><button data-open="blog">Blog</button><button data-open="projects">Projects</button><button data-open="cmd">Command Prompt</button><button data-display-properties>Settings → Display</button></div>
  <dialog id="display-properties" class="classic-window display-properties" aria-labelledby="display-properties-title">
    <form method="dialog">
      <div class="titlebar"><strong id="display-properties-title">Display Properties</strong><button aria-label="Close Display Properties" value="cancel">×</button></div>
      <fieldset><legend>Desktop theme</legend>
        {themes.map(theme => <label><input type="radio" name="desktop-theme" value={theme.id} /> {theme.label}</label>)}
      </fieldset>
      <div class="dialog-actions"><button value="cancel">Cancel</button><button type="button" data-apply-theme>Apply</button></div>
    </form>
  </dialog>
  <footer class="taskbar"><button id="start-button" aria-expanded="false">▦ Start</button><button id="document-task">About Me.doc - WordPad</button><button data-open="cmd">&gt;_</button><time id="desktop-clock"></time></footer>
</div>
<template id="skin-about"><h1>About</h1><Biography /></template>
<template id="skin-projects"><h1>Projects</h1>{projects.map(project => <section><h2>{project.name}</h2><p>{project.description}</p><div class="project-destinations">{project.links.map(link => <a href={link.href}>{link.brand === 'homebrew' ? 'Homebrew' : link.brand === 'pypi' ? 'PyPI' : 'GitHub'}</a>)}</div></section>)}</template>
<template id="skin-blog"><h1>Blog</h1><ul>{posts.map(post => <li><a href={`/blog/${post.id}`}>{post.data.title}</a><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric'})}</time></li>)}</ul></template>
<template id="skin-manual">
  <div class="manual-heading"><span>CHUCKD(1)</span><span>General Commands Manual</span><span>CHUCKD(1)</span></div>
  <h2>NAME</h2><div class="manual-indent"><b>chuckd</b> – Chuck Danielsson; builds software and the systems that keep it running</div>
  <h2>SYNOPSIS</h2><div class="manual-indent"><b>chuckd</b> [<button data-command="cat about.txt">--about</button>] [<button data-command="ls projects">--projects</button>] [<button data-command="ls blog">--blog</button>] [<button data-command="theme">--theme</button> name]</div>
  <h2>DESCRIPTION</h2><div class="manual-indent">I build software and the systems that keep it running. Most of my career has been in application development, with a focus on delivery and user experience. Mathematics came before technology: questions that matter, and answers that work in practice.</div>
  <h2>OPTIONS</h2><dl class="manual-indent"><dt><button data-command="cat about.txt">--about</button></dt><dd>Print the full biography (<b>cat about.txt</b>).</dd><dt><button data-command="ls projects">--projects</button></dt><dd>List software the author maintains (<b>ls projects</b>).</dd><dt><button data-command="ls blog">--blog</button></dt><dd>List posts, newest first (<b>ls blog</b>).</dd><dt><button data-command="theme">--theme</button> name</dt><dd>Re-skin the whole site. Your choice is remembered across pages and visits (<b>theme</b>).</dd></dl>
  <h2>SEE ALSO</h2><div class="manual-indent"><a href="https://github.com/dcchuck">github(1)</a>, <a href="https://x.com/dcChuck">x(1)</a>{projects.map(project => <>, <a href={project.links[0].href}>{project.name}(1)</a></>)}</div>
  <h2>BUGS</h2><div class="manual-indent">If there are no interesting problems around, he tends to find them.</div>
  <div class="manual-heading manual-footer"><span>chuckd.dev</span><span>chuckd.dev</span></div>
</template>
{projects.map(project => <template data-shell-file data-path={`/home/chuck/projects/${project.name}.txt`}><pre>{`${project.name}\n\n${project.description}\n\n${project.links.map(link => `${link.brand}: ${link.href}`).join('\n')}`}</pre></template>)}
{posts.map(post => <template data-shell-file data-path={`/home/chuck/blog/${post.id}.md`}><pre>{post.body}</pre></template>)}
<script src="../scripts/skins.ts"></script>
